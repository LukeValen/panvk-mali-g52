+static VkResult
+kbase_cpu_sync_wait_sync_file(void *data,
+                              const uint64_t targets[PANVK_KBASE_SYNC_TARGET_COUNT],
+                              uint64_t abs_timeout_ns)
+{
+   struct kbase_cpu_sync *ks = data;
+   (void)targets;
+   int timeout_ms = -1;
+
+   if (abs_timeout_ns != UINT64_MAX) {
+      uint64_t now = os_time_get_nano();
+      if (abs_timeout_ns <= now)
+         timeout_ms = 0;
+      else
+         timeout_ms = MIN2(DIV_ROUND_UP(abs_timeout_ns - now, 1000000ull), INT_MAX);
+   }
+
+   if (sync_wait(ks->sync_file_fd, timeout_ms) == 0)
+      return VK_SUCCESS;
+
+   return errno == ETIME ? VK_TIMEOUT : VK_ERROR_UNKNOWN;
+}
+
+static VkResult
+kbase_cpu_sync_import_sync_file(struct vk_device *device,
+                                struct vk_sync *sync, int sync_file)
+{
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   int fd = -1;
+
+   if (sync_file >= 0) {
+      fd = fcntl(sync_file, F_DUPFD_CLOEXEC, 3);
+      if (fd < 0)
+         return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   mtx_lock(&ks->mutex);
+   assert(ks->state != KBASE_CPU_SYNC_WAITING);
+   if (ks->sync_file_fd >= 0)
+      close(ks->sync_file_fd);
+   ks->sync_file_fd = fd;
+   ks->pending_data = NULL;
+   ks->pending_wait = NULL;
+   ks->result = VK_SUCCESS;
+   memset(ks->targets, 0, sizeof(ks->targets));
+
+   if (fd < 0) {
+      ks->state = KBASE_CPU_SYNC_SIGNALED;
+   } else {
+      ks->pending_data = ks;
+      ks->pending_wait = kbase_cpu_sync_wait_sync_file;
+      ks->state = KBASE_CPU_SYNC_PENDING;
+   }
+
    u_cnd_monotonic_broadcast(&ks->cond);
    mtx_unlock(&ks->mutex);
+   return VK_SUCCESS;
 }
 
